{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/aidlc-ui-first/addon/templates/progress-event.schema.json",
  "title": "ui/progress.jsonl event (one JSON object per line)",
  "type": "object",
  "required": ["schemaVersion", "ts", "version", "phase", "status", "message"],
  "additionalProperties": true,
  "properties": {
    "schemaVersion": { "const": 1 },
    "ts": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "version": { "type": "integer", "minimum": 1 },
    "phase": { "enum": ["brief", "screen", "assemble", "gate", "repair", "critic", "publish", "done"] },
    "status": { "enum": ["start", "done", "pass", "fail", "info", "skip"] },
    "screen": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48 }] },
    "check": { "oneOf": [{ "type": "null" }, { "enum": ["console", "overflow", "axe", "lighthouse", "network", "data", "critic"] }] },
    "n": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 0 }] },
    "of": { "oneOf": [{ "type": "null" }, { "type": "integer", "minimum": 1 }] },
    "message": { "type": "string", "minLength": 1, "maxLength": 140 }
  }
}
