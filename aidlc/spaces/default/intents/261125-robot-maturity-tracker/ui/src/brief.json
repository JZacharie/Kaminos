    ],
    "series": [
      { "name": "printsByStatus", "shape": "4 items {status, count}", "definition": "prints per status: Validée 7, En impression 3, À préparer 7, À réimprimer 3" },
      { "name": "ordersByStatus", "shape": "4 items {status, count}", "definition": "orders per status" },
      { "name": "repairsBySeverity", "shape": "3 items {severity, count}", "definition": "repairs not closed per severity" }
    ],
    "agree": [
      { "kpi": "meanScore", "shownOn": ["a-kpi-mean-score"], "rule": "mean robot score, points out of 100" },
      { "kpi": "criticalOpen", "shownOn": ["a-kpi-critical", "a-prerequisites"], "rule": "open critical repairs, count" },
      { "kpi": "partsToPrint", "shownOn": ["a-kpi-toprint", "a-prints-summary"], "rule": "prints not validated, count" },
      { "kpi": "toOrderEur", "shownOn": ["a-kpi-orders-total"], "rule": "sum of À commander orders, EUR" },
      { "kpi": "belowMin", "shownOn": ["a-kpi-stock-low", "a-stock-alerts"], "rule": "stock rows under minimum, count" }
    ]
  },
