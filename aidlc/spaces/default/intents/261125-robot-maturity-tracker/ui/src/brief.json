  "dataEntities": [
    {
      "name": "robots", "rows": 6, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "R-03" },
        { "name": "name", "type": "string", "example": "T-X" },
        { "name": "type", "type": "string", "example": "hexapode" },
        { "name": "scoreChassis", "type": "integer", "unit": "pts", "example": 64 },
        { "name": "scoreMobility", "type": "integer", "unit": "pts", "example": 48 },
        { "name": "scoreEnergy", "type": "integer", "unit": "pts", "example": 52 },
        { "name": "scoreSensors", "type": "integer", "unit": "pts", "example": 40 },
        { "name": "scoreControl", "type": "integer", "unit": "pts", "example": 44 },
        { "name": "score", "type": "integer", "unit": "pts", "example": 50 },
        { "name": "palier", "type": "enum", "enum": ["P1 Prototype", "P2 Fonctionnel", "P3 Fiable", "P4 Autonome"], "example": "P3 Fiable" },
        { "name": "palierShown", "type": "enum", "enum": ["P1 Prototype", "P2 Fonctionnel", "P3 Fiable", "P4 Autonome"], "example": "P2 Fonctionnel" },
        { "name": "frozen", "type": "string", "example": "Mobilité, Énergie" },
        { "name": "criticalOpen", "type": "integer", "example": 2 }
      ],
      "thresholds": [
        { "name": "score", "rule": "mean of the 5 subsystem scores, rounded" },
        { "name": "palier", "rule": "0-24 P1, 25-49 P2, 50-74 P3, 75-100 P4" },
        { "name": "palierShown", "rule": "palier minus one level while criticalOpen > 0; frozen lists the subsystems of open critical repairs" }
      ]
    },
    {
      "name": "prints", "rows": 20, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "IM-107" },
        { "name": "part", "type": "string", "example": "Tibia A v3" },
        { "name": "robotId", "type": "string", "example": "R-03" },
        { "name": "material", "type": "enum", "enum": ["PLA+", "PETG", "ASA", "PA-CF", "TPU", "Résine tough"], "example": "PETG" },
        { "name": "priority", "type": "enum", "enum": ["Haute", "Moyenne", "Basse"], "example": "Haute" },
        { "name": "grams", "type": "integer", "unit": "g", "example": 76 },
        { "name": "hours", "type": "number", "unit": "h", "example": 3.5 },
        { "name": "status", "type": "enum", "enum": ["À préparer", "En impression", "Validée", "À réimprimer"], "example": "À réimprimer" }
      ],
      "relations": [{ "field": "robotId", "entity": "robots" }],
      "thresholds": [{ "name": "toPrint", "rule": "status other than Validée counts as left to print" }]
    },
    {
      "name": "orders", "rows": 12, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "CMD-31" },
        { "name": "component", "type": "string", "example": "Servos 20 kg x12" },
        { "name": "linkedTo", "type": "string", "example": "IM-110" },
        { "name": "supplier", "type": "string", "example": "ElecDirect" },
        { "name": "totalEur", "type": "number", "unit": "EUR", "example": 118.8 },
        { "name": "eta", "type": "date", "example": "2026-11-28" },
        { "name": "status", "type": "enum", "enum": ["À commander", "Commandée", "Expédiée", "Reçue"], "example": "À commander" }
      ],
      "thresholds": [{ "name": "eta", "rule": "empty for À commander; arrival date for Reçue" }]
    },
    {
      "name": "stock", "rows": 17, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "ST-04" },
        { "name": "name", "type": "string", "example": "Servos 20 kg" },
        { "name": "category", "type": "enum", "enum": ["Visserie", "Moteurs", "Drivers", "Capteurs", "Filaments", "Résine", "Tampon générateur"], "example": "Moteurs" },
        { "name": "quantity", "type": "number", "example": 4 },
        { "name": "minimum", "type": "number", "example": 6 },
        { "name": "unit", "type": "string", "example": "pièces" },
        { "name": "belowMin", "type": "boolean", "example": true }
      ],
      "thresholds": [{ "name": "belowMin", "rule": "quantity < minimum; buffer rows below minimum show the seuil bas flag" }]
    },
    {
      "name": "repairs", "rows": 12, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "RP-04" },
        { "name": "date", "type": "date", "example": "2026-11-12" },
        { "name": "robotId", "type": "string", "example": "R-03" },
        { "name": "subsystem", "type": "enum", "enum": ["Châssis", "Mobilité", "Énergie", "Capteurs", "Contrôle"], "example": "Mobilité" },
        { "name": "part", "type": "string", "example": "Tibia A v2" },
        { "name": "anomaly", "type": "string", "example": "Rupture à la charnière" },
        { "name": "fix", "type": "string", "example": "Tibia A v3" },
        { "name": "severity", "type": "enum", "enum": ["Critique", "Majeure", "Mineure"], "example": "Critique" },
        { "name": "status", "type": "enum", "enum": ["Ouverte", "Correctif en cours", "À valider", "Clôturée"], "example": "Correctif en cours" }
      ],
      "relations": [{ "field": "robotId", "entity": "robots" }]
    },
    {
      "name": "partVersions", "rows": 14, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "PV-01" },
        { "name": "part", "type": "string", "example": "Tibia A" },
        { "name": "robotId", "type": "string", "example": "R-03" },
        { "name": "version", "type": "string", "example": "v2" },
        { "name": "outcome", "type": "enum", "enum": ["Défaut constaté", "Validée", "En test", "En impression", "À réimprimer"], "example": "Défaut constaté" },
        { "name": "note", "type": "string", "example": "Rupture à la charnière (RP-04)" }
      ],
      "thresholds": [{ "name": "recurring", "rule": "a part with 2 or more versions marked Défaut constaté is a défaut récurrent" }]
    },
    {
      "name": "subassemblies", "rows": 8, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "SA-05" },
        { "name": "robotId", "type": "string", "example": "R-03" },
        { "name": "name", "type": "string", "example": "Tibias" },
        { "name": "requires", "type": "string", "example": "IM-107, IM-108, IM-109" },
        { "name": "readiness", "type": "enum", "enum": ["Prêt à assembler", "Attente impressions", "Attente composants", "Bloqué par réparation"], "example": "Bloqué par réparation" }
      ],
      "thresholds": [{ "name": "readiness", "rule": "Prêt à assembler only when every required print is Validée and every linked order is Reçue" }]
    },
    {
      "name": "prerequisites", "rows": 12, "key": "id",
      "fields": [
        { "name": "id", "type": "id", "example": "PR-01" },
        { "name": "robotId", "type": "string", "example": "R-03" },
        { "name": "label", "type": "string", "example": "Clôturer la réparation RP-04" },
        { "name": "kind", "type": "enum", "enum": ["Impression", "Commande", "Réparation", "Score"], "example": "Réparation" },
        { "name": "linkedId", "type": "string", "example": "RP-04" },
        { "name": "done", "type": "boolean", "example": false }
      ],
      "relations": [{ "field": "robotId", "entity": "robots" }]
    }
  ],
  "dataDerived": {
